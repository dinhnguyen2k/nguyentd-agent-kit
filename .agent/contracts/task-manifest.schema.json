{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinhnguyen2k/nguyentd-agent-kit/task-manifest.schema.json",
  "title": "NguyenTD PHP Agent Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "tier", "task_id", "slice_id", "contract_ref", "contract_version", "contract_hash", "lifecycle_hash", "goal", "mode", "owner", "independent_verification", "allowed_paths", "source_paths", "acceptance_criteria", "dependencies", "validation_commands", "stop_conditions"],
  "properties": {
    "manifest_version": { "const": 2 },
    "tier": { "const": "governed" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$" },
    "slice_id": { "type": "string", "minLength": 1 },
    "contract_ref": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lifecycle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goal": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["analysis", "proposal", "implementation", "verification"] },
    "owner": { "type": "string", "minLength": 1 },
    "independent_verification": { "const": true },
    "allowed_paths": { "$ref": "#/$defs/strings" },
    "source_paths": { "$ref": "#/$defs/strings" },
    "acceptance_criteria": { "$ref": "#/$defs/strings" },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validation_commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "slice_id", "contract_version", "lifecycle_ref", "goal", "mode", "owner", "allowed_paths", "source_paths", "acceptance", "dependencies", "permitted_checks", "stop_conditions"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$" },
        "slice_id": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "integer", "minimum": 1 },
        "lifecycle_ref": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["analysis", "proposal", "implementation", "verification"] },
        "owner": { "type": "string", "minLength": 1 },
        "allowed_paths": { "$ref": "#/$defs/strings" },
        "source_paths": { "$ref": "#/$defs/strings" },
        "acceptance": { "$ref": "#/$defs/strings" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "permitted_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "stop_conditions": { "$ref": "#/$defs/strings" }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "status", "blocker", "next_action", "owner", "contract_versions", "source_snapshot", "superseded_by", "archived"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "blocked", "closed", "superseded"] },
        "blocker": { "type": ["string", "null"] },
        "next_action": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "contract_versions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "source_snapshot": { "type": ["string", "null"] },
        "superseded_by": { "type": ["string", "null"] },
        "archived": { "type": "boolean" },
        "legacy_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content_hash", "classification", "reason", "replacement_contract"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "classification": { "const": "historical-only" },
              "reason": { "type": "string", "minLength": 1 },
              "replacement_contract": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
