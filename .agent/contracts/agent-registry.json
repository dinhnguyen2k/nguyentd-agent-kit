{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 3,
  "invariants": {
    "test_authorship_separation": "An agent that writes production code must never create or modify test files, and must never weaken an existing assertion to make a build pass. Test authorship belongs to `test-author` only. Enforced at runtime by `.agent/scripts/agent-boundary-guard.mjs` (rule R2), not by prose.",
    "execution_role_separation": "DO NOT RUN lint, syntax check, or tests automatically. ON-DEMAND ONLY: the user must explicitly request the action. Test suites remain restricted to verifier/test-author by rule R1."
  },
  "test_paths": [
    "tests/**",
    "tests",
    "*Test.php",
    "**/*Test.php",
    "*.test.js",
    "**/*.test.js",
    "*.spec.js",
    "**/*.spec.js",
    "**/__tests__/**",
    "__tests__/**"
  ],
  "protected_config_paths": [
    ".agent/contracts/agent-registry.json",
    ".agent/scripts/agent-boundary-guard.mjs",
    ".agent/scripts/agent-role.sh",
    ".claude/settings.json",
    ".claude/settings.local.json",
    "AI_RULES.md",
    "OPINION.md"
  ],
  "shared_write_paths": [".agent/reports/**", ".agent/scratch/**", ".agent/task-manifests/**"],
  "enforcement": {
    "guard": ".agent/scripts/agent-boundary-guard.mjs",
    "guard_modes": {
      "hook": "stdin JSON -> JSON quyết định (Claude Code PreToolUse)",
      "cli": "--check-command <cmd> | --check-write <path> [--role <role>], exit 2 khi bị chặn"
    },
    "harness": {
      "canonical_wiring_dir": ".agent/harness",
      "installer": ".agent/scripts/install-harness-wiring.sh",
      "claude": {
        "wiring": ".agent/harness/claude/settings.json",
        "symlink": ".claude/settings.json -> ../.agent/harness/claude/settings.json",
        "enforcement": "hook (cứng)"
      },
      "codex": { "enforcement": "CLI mode + prose", "note": "chưa có PreToolUse hook" },
      "antigravity": { "enforcement": "CLI mode + prose", "note": "chưa có PreToolUse hook" }
    },
    "role_state": ".agent/scratch/.runtime/agent-role",
    "role_control": ".agent/scripts/agent-role.sh",
    "role_inline": "COGAIN_AGENT_ROLE=<role> đứng đầu dòng lệnh, có hiệu lực cho đúng lệnh đó và luôn hiện trong transcript",
    "audit_log": ".agent/reports/boundary-guard.log",
    "default_role": "implementer",
    "role_ttl_hours": 8,
    "role_semantics": "State file và inline chỉ CẤP THÊM năng lực (R1/R2). Ràng buộc write_paths (R4) chỉ áp khi role đến từ danh tính subagent thật hoặc env, để không gông nhầm seat đang chạy song song.",
    "fail_mode": "open-on-crash",
    "limits": "Guard chặn được nhầm lẫn và thói quen, không chặn được cố ý mạo danh role trong cùng một process. Nó làm việc vượt ranh giới trở nên tường minh và có log, thay vì âm thầm.",
    "rules": {
      "test_runner": {
        "id": "R1",
        "applies_to": ["Bash"],
        "allowed_roles": ["verifier", "test-author"],
        "deny_message": "Permission Denied: Running test suites (PHPUnit, composer test) is strictly reserved for 'verifier' and 'test-author'.",
        "patterns": [
          "\\bphpunit\\b",
          "\\bcomposer\\s+(?:run(?:-script)?\\s+)?test(?::|\\s|$)",
          "\\b(npm|pnpm|yarn|npx|bun)\\s+(?:run\\s+)?test(?::|\\s|$)",
          "\\bvitest\\b",
          "\\bjest\\b",
          "\\bplaywright\\s+test\\b"
        ]
      },
      "test_write": {
        "id": "R2",
        "applies_to": ["Edit", "Write", "MultiEdit", "NotebookEdit", "Bash"],
        "allowed_roles": ["test-author"],
        "shell_path_markers": [
          "tests/",
          "Test.php",
          "__tests__/",
          ".test.js",
          ".spec.js"
        ],
        "shell_mutating_tokens": [
          "sed -i",
          "cp ",
          "mv ",
          "rm ",
          "tee ",
          ">",
          "truncate",
          "git checkout",
          "git restore",
          "git apply",
          "patch ",
          "ln "
        ]
      },
      "self_protect": {
        "id": "R3",
        "applies_to": ["Edit", "Write", "MultiEdit", "Bash"],
        "allowed_roles": ["maintainer"],
        "shell_matching": "Nhánh Bash bỏ qua `2>&1` và `>/dev/null`, và chỉ tính khi đường dẫn được bảo vệ đứng SAU token ghi. `cat settings.json > /tmp/x` không bị chặn; `sed -i ... settings.json` thì bị.",
        "known_false_positive": "Đường dẫn được bảo vệ nằm trong chuỗi trích dẫn ĐỨNG SAU một token ghi (ví dụ `sed -i 's|registry.json|...|' file-khac.md`) vẫn bị chặn. Dùng Edit/Write cho file không được bảo vệ, hoặc bật maintainer."
      },
      "write_boundary": {
        "id": "R4",
        "applies_to": ["Edit", "Write", "MultiEdit", "NotebookEdit"],
        "note": "write_paths/deny_write_paths chỉ được áp khi một role cụ thể đang bật. Role mặc định `implementer` chỉ chịu R1/R2/R3 để phiên làm việc thường không bị chặn oan."
      }
    }
  },
  "command_policy": {
    "note": "Whitelist mô tả ý định; cưỡng chế thật nằm ở enforcement.rules và permissions trong .claude/settings.json.",
    "build_only": ["php -l <file> (khi php runtime có sẵn)", "composer validate (khi composer có sẵn)", "node --check <file>"],
    "verification_only": ["vendor/bin/phpunit (khi PHPUnit có sẵn)", "php vendor/bin/phpunit", "composer test"]
  },
  "agents": [
    {
      "name": "orchestrator",
      "profile": null,
      "kind": "control",
      "write_paths": [],
      "deny_write_paths": [],
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "skills": ["orchestrate"],
      "commands": { "allow": [], "deny": ["phpunit", "vendor/bin/phpunit", "php vendor/bin/phpunit", "composer test"] }
    },
    {
      "name": "backend-specialist",
      "profile": ".agent/agents/backend-specialist.md",
      "kind": "worker",
      "write_paths": [
        "*.php",
        "**/*.php",
        "admin/**",
        "composer.json",
        "composer.lock",
        "src/**",
        "config/**",
        "public/**",
        "migrations/**"
      ],
      "deny_write_paths": [
        "vendor/**",
        "vendor",
        "tests/**",
        "tests",
        "*Test.php",
        "**/*Test.php",
        "*.test.js",
        "**/*.test.js",
        "*.spec.js",
        "**/*.spec.js",
        "**/__tests__/**",
        "__tests__/**",
        "uploads/**",
        "uploads",
        "admin/uploads/**",
        "admin/uploads",
        "admin/ckeditor/**",
        "admin/ckeditor",
        ".agent/**",
        ".git/**"
      ],
      "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "skills": ["backend-development", "php-development", "mysql"],
      "commands": {
        "allow": ["php -l <file>", "composer validate"],
        "deny": [
          "phpunit",
          "vendor/bin/phpunit",
          "./vendor/bin/phpunit",
          "php vendor/bin/phpunit",
          "composer test",
          "composer run test",
          "composer run-script test"
        ]
      },
      "handoff": "HAND OFF IMPLEMENTATION WITHOUT WAITING FOR UNREQUESTED VALIDATION. DO NOT RUN php syntax checks, composer validate, or tests automatically. ON-DEMAND ONLY: the user must explicitly request the action. Commands like php -l require PHP runtime installed. Presentation outside backend logic belongs to frontend-specialist."
    },
    {
      "name": "frontend-specialist",
      "profile": ".agent/agents/frontend-specialist.md",
      "kind": "worker",
      "write_paths": [
        "css/**",
        "js/**",
        "images/**",
        "layout/**",
        "admin/css/**",
        "admin/js/**"
      ],
      "deny_write_paths": [
        "*.php",
        "vendor/**",
        "vendor",
        "tests/**",
        "tests",
        "*Test.php",
        "**/*Test.php",
        "*.test.js",
        "**/*.test.js",
        "*.spec.js",
        "**/*.spec.js",
        "**/__tests__/**",
        "__tests__/**",
        "uploads/**",
        "uploads",
        "admin/uploads/**",
        "admin/uploads",
        "admin/ckeditor/**",
        "src/**",
        "config/**",
        ".agent/**",
        ".git/**"
      ],
      "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "skills": ["frontend-development"],
      "commands": {
        "allow": ["node --check <file>"],
        "deny": ["phpunit", "vendor/bin/phpunit", "composer test", "npm test"]
      },
      "handoff": "HAND OFF IMPLEMENTATION WITHOUT WAITING FOR UNREQUESTED VALIDATION. DO NOT RUN lint, style, or test commands automatically. ON-DEMAND ONLY: the user must explicitly request the validation action by name. Frontend owns layout/** templates, css/**, js/**, images/**. Root/admin PHP presentation changes require explicit handoff with single-owner per task."
    },
    {
      "name": "test-author",
      "profile": ".agent/agents/test-author.md",
      "kind": "worker",
      "write_paths": [
        "tests/**",
        "tests",
        "*Test.php",
        "**/*Test.php",
        "*.test.js",
        "**/*.test.js",
        "*.spec.js",
        "**/*.spec.js",
        "**/__tests__/**",
        "__tests__/**"
      ],
      "deny_write_paths": [
        "index.php",
        "db.php",
        "admin/**",
        "layout/**",
        "css/**",
        "js/**",
        "images/**",
        "src/**",
        "config/**",
        "public/**",
        "vendor/**",
        "vendor",
        "uploads/**",
        "uploads",
        "admin/uploads/**",
        "admin/uploads",
        ".agent/**",
        ".git/**"
      ],
      "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "skills": ["testing-patterns", "tdd-workflow"],
      "commands": {
        "allow": [
          "vendor/bin/phpunit --filter <test>",
          "php vendor/bin/phpunit --filter <test>",
          "./vendor/bin/phpunit --filter <test>",
          "composer test",
          "composer run test"
        ],
        "deny": []
      },
      "parallel_safe_with": ["backend-specialist", "frontend-specialist"],
      "runtime_registration": "subagent thật: .claude/agents/test-author.md -> ../../.agent/agents/test-author.md"
    },
    {
      "name": "verifier",
      "profile": ".agent/agents/verifier.md",
      "kind": "gate",
      "write_paths": [],
      "deny_write_paths": [
        "*.php",
        "**/*.php",
        "admin/**",
        "css/**",
        "js/**",
        "layout/**",
        "images/**",
        "src/**",
        "config/**",
        "public/**",
        "vendor/**",
        "vendor",
        "tests/**",
        "tests",
        "*Test.php",
        "**/*Test.php",
        "uploads/**",
        "uploads",
        "admin/uploads/**",
        "admin/uploads",
        ".agent/**"
      ],
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "skills": ["lint-and-validate", "testing-patterns", "code-reviewer"],
      "commands": {
        "allow": [
          "php -l <file>",
          "composer validate",
          "vendor/bin/phpunit",
          "php vendor/bin/phpunit",
          "./vendor/bin/phpunit",
          "composer test",
          "composer run test",
          "composer run-script test",
          "git stash/diff"
        ],
        "deny": ["mọi thao tác ghi vào mã nguồn hoặc file test"]
      },
      "activation": "A governed task may activate read-only source verification. DO NOT RUN validation commands unless the user explicitly requests the action and scope. Commands requiring PHP/Composer/PHPUnit only run when installed.",
      "runtime_registration": "subagent thật: .claude/agents/verifier.md -> ../../.agent/agents/verifier.md. Không có Edit/Write ở tầng runtime, đó là ranh giới cứng thật sự."
    }
  ]
}
