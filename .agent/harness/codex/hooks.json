{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command|.*apply_patch.*|Edit|Write|MultiEdit|Task|spawn_agent|call_mcp_tool|mcp__filesystem__.*|mcp__.*lsp.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \".agent/harness/codex/hook-entry.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra ranh giới Codex..."
          }
        ]
      }
    ]
  }
}
