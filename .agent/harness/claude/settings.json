{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Task|Agent|mcp__filesystem__.*|call_mcp_tool|mcp__.*lsp.*",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${AGY_LSP_HOME:-$HOME/.local/share/agy-lsp}/bin/cogain-hook\"; [ -x \"$B\" ] && exec \"$B\" claude; exec node \"${CLAUDE_PROJECT_DIR:-.}/.agent/harness/claude/hook-entry.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra ranh giới & contract..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Task|Agent|TodoWrite|call_mcp_tool|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${AGY_LSP_HOME:-$HOME/.local/share/agy-lsp}/bin/cogain-hook\"; [ -x \"$B\" ] && exec \"$B\" claude; exec node \"${CLAUDE_PROJECT_DIR:-.}/.agent/harness/claude/hook-entry.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${AGY_LSP_HOME:-$HOME/.local/share/agy-lsp}/bin/cogain-hook\"; [ -x \"$B\" ] && exec \"$B\" claude; exec node \"${CLAUDE_PROJECT_DIR:-.}/.agent/harness/claude/hook-entry.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${AGY_LSP_HOME:-$HOME/.local/share/agy-lsp}/bin/cogain-hook\"; [ -x \"$B\" ] && exec \"$B\" claude; exec node \"${CLAUDE_PROJECT_DIR:-.}/.agent/harness/claude/hook-entry.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${AGY_LSP_HOME:-$HOME/.local/share/agy-lsp}/bin/cogain-hook\"; [ -x \"$B\" ] && exec \"$B\" claude; exec node \"${CLAUDE_PROJECT_DIR:-.}/.agent/harness/claude/hook-entry.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
