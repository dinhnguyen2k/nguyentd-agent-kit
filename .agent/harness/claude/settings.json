{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.agent/scripts/agent-boundary-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra ranh giới agent..."
          }
        ]
      }
    ]
  }
}
