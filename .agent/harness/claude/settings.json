{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(phpunit:*)",
      "Bash(phpunit *)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/phpunit *)",
      "Bash(php vendor/bin/phpunit:*)",
      "Bash(php vendor/bin/phpunit *)",
      "Bash(php ./vendor/bin/phpunit:*)",
      "Bash(php ./vendor/bin/phpunit *)",
      "Bash(composer test:*)",
      "Bash(composer test *)",
      "Bash(composer run test:*)",
      "Bash(composer run test *)",
      "Bash(composer run-script test:*)",
      "Bash(composer run-script test *)",
      "Bash(npm test:*)",
      "Bash(npm test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-$PWD}/.agent/scripts/agent-boundary-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra ranh giới agent..."
          }
        ]
      }
    ]
  }
}
